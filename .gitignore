# ============================================================
# DummyBird — 仓库级忽略规则
# 仓库根 = .../games/dummy-bird（GAME/ 是 Godot 工程，SORCE/ 是美术源文件）
# 原则：忽略"机器生成 / 可重新生成 / 本机私有"的东西；
#       源文件（含 .aseprite / .psd / .kra）一律入库——没版本控制 = 没备份。
# ============================================================

# ---------- AI 会话 / 记忆数据（本机私有，绝不入库）----------
.dsh-meow/
.dsh/

# ---------- Godot 引擎生成物（编辑器重开即可重建）----------
.godot/
/android/
*.translation

# ---------- Godot 导出产物（只忽略产物，不忽略配置）----------
# ⚠️ export_presets.cfg 必须【提交】——它记录 Web/Android 的导出配置，
#    官方版本控制文档明确建议入库；忽略它会让换机后无法一键导出。
EXPORTS/
EXPORTS_*/
build/
dist/

# ---------- 签名密钥（绝不入库）----------
*.keystore
*.jks
*.pepk
release.keystore

# ---------- 注：*.uid 必须提交 ----------
# Godot 4.4+ 为脚本/资源生成 .uid（稳定的资源标识）。
# 官方建议提交，否则引擎需按路径重建 UID，改路径时易产生引用错乱。
# 因此这里【有意不忽略】*.uid。

# ---------- 编辑器 / 系统垃圾 ----------
.DS_Store
Thumbs.db
desktop.ini
*~
*.orig
*.rej
*.bak
*.tmp
*.log

# ---------- IDE / 工具 ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- 本机私有配置（需共享请用 .example 副本入库）----------
*.local
.env
.env.*
!.env.example
