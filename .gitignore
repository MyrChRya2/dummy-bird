# ============================================================
# DummyBird — 仓库级忽略规则
# 仓库根 = .../games/dummy-bird（GAME/ 是 Godot 工程，SORCE/ 是美术源文件）
# 原则：忽略"机器生成 / 可重新生成 / 本机私有"的东西；
#       源文件（含 .aseprite / .psd / .kra）一律入库——没版本控制 = 没备份。
# ============================================================

# ---------- AI 会话 / 记忆数据（本机私有，绝不入库）----------
.dsh-meow/
.dsh/

# ---------- Godot 引擎生成物（编辑器重开即可重建）----------
.godot/
/android/
*.translation

# ---------- Godot 导出产物（导出目录整体排除，见下）----------
export_presets.cfg
EXPORTS/
EXPORTS_*/
build/
dist/

# ---------- 编辑器 / 系统垃圾 ----------
.DS_Store
Thumbs.db
desktop.ini
*~
*.orig
*.rej
*.bak
*.tmp
*.log

# ---------- IDE / 工具 ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- 本机私有配置（需共享请用 .example 副本入库）----------
*.local
.env
.env.*
!.env.example
